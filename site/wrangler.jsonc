{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kamui",
  "account_id": "a1c063f2b61e3d882199d1efdd34043c",
  "compatibility_date": "2026-10-15",
  // A static site: no Worker script, only the built pages. Pages build to
  // docs/cli.html and so on, and assets serve them at /docs/cli.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [{ "pattern": "kamui.narasaka.dev", "custom_domain": true }],
  "workers_dev": false,
  // Workers Builds runs `wrangler preview` for branches other than main.
  "previews": {},
}
