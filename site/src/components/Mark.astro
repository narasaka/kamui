---
import favicon from "../../public/favicon.svg?raw";

interface Props {
  class?: string;
}

// Reuse the favicon's paths so the mark follows the page theme via currentColor.
const paths = /<g[\s\S]*<\/g>/.exec(favicon)?.[0];
if (!paths) throw new Error("public/favicon.svg has no <g> element");
---

<svg class={Astro.props.class} viewBox="0 0 100 100" fill="currentColor" role="img" aria-label="Kamui" set:html={paths} />
